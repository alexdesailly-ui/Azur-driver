{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/alaplace/trajet.schema.json",
  "title": "Trajet à la place",
  "description": "Description ouverte d'un trajet vendu à la place par un chauffeur VTC. Le schéma n'a AUCUN champ d'horaire fixe : un départ est toujours composé à partir des réservations (règle juridique, voir protocole.md).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "nom", "operateur", "mode", "periode", "zones", "trajets", "capacite", "seuil", "prix_place_eur", "reservation"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$", "description": "identifiant-du-chauffeur.nom-du-trajet : évite les collisions entre chauffeurs"},
    "nom": {"type": "string", "minLength": 3},
    "operateur": {"type": "object", "additionalProperties": false, "required": ["id", "nom", "registre_evtc"],
      "properties": {"id": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "nom": {"type": "string"}, "registre_evtc": {"type": "string"}, "site": {"type": "string", "format": "uri"}}},
    "mode": {"const": "a_la_demande"},
    "note_juridique": {"type": "string"},
    "note_zones": {"type": "string"},
    "periode": {"type": "object", "additionalProperties": false, "required": ["debut", "fin", "jours"],
      "properties": {"debut": {"type": "string", "format": "date"}, "fin": {"type": "string", "format": "date"},
        "jours": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["lundi", "mardi", "mercredi", "jeudi", "vendredi", "samedi", "dimanche"]}}}},
    "zones": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["id", "nom", "boite"],
      "properties": {"id": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "nom": {"type": "string"},
        "boite": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}, "description": "[ouest, sud, est, nord] en degrés WGS84"}}}},
    "trajets": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "de", "vers", "prise_en_charge", "depose"],
      "properties": {"id": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "de": {"type": "string"}, "vers": {"type": "string"},
        "prise_en_charge": {"$ref": "#/$defs/fenetre"}, "depose": {"$ref": "#/$defs/fenetre"}}}},
    "capacite": {"type": "integer", "minimum": 1, "maximum": 8, "description": "8 places passagers au plus (VTC)"},
    "seuil": {"type": "integer", "minimum": 1},
    "prix_place_eur": {"type": "number", "exclusiveMinimum": 0},
    "reservation": {"type": "object", "additionalProperties": false, "required": ["url", "ouverture_jours_avant"],
      "properties": {"jours_avant_min": {"type": "integer", "minimum": 1}, "heure_limite": {"type": "string", "pattern": "^\\d{2}:\\d{2}$"},
        "preavis_minutes": {"type": "integer", "minimum": 30}, "ouverture_jours_avant": {"type": "integer", "minimum": 1}, "url": {"type": "string", "format": "uri"}},
      "oneOf": [{"required": ["jours_avant_min", "heure_limite"]}, {"required": ["preavis_minutes"]}]}
  },
  "$defs": {"fenetre": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "pattern": "^\\d{2}:\\d{2}$"}, "description": "fenêtre [début, fin] ; au-delà de 24:00 pour la nuit (format GTFS)"}}
}
